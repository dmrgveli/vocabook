{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocabook-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "vocabook" }],
  // GOOGLE_CLIENT_ID is set as a Worker secret (wrangler secret put GOOGLE_CLIENT_ID),
  // so no account-specific values live in the repository.
  "vars": {
    "ALLOWED_ORIGINS": "https://dmrgveli.github.io"
  },
  "observability": { "enabled": true }
}
